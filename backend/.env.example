PORT=4821
APP_NAME=Doctor Tracker
APP_TAGLINE=Clinical operations desk
PUBLIC_API_URL=http://127.0.0.1:4821

# Leave unset to use mongodb-memory-server for local demos.
# MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/doctor-tracker?retryWrites=true&w=majority
MONGODB_URI=

JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=14
COOKIE_SECURE=false

# Comma-separated browser origins allowed for CORS cookies
CLIENT_ORIGIN=http://127.0.0.1:4317,http://localhost:4317
CORS_EXTRA_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_VERCEL_PREVIEWS=true

# Seeded clinic accounts — change these freely; UI reads them from the API
ADMIN_NAME=Clinic Admin
ADMIN_EMAIL=admin@doctortracker.com
ADMIN_PASSWORD=Admin@123
RECEPTIONIST_NAME=Front Desk
RECEPTIONIST_EMAIL=front.desk@doctortracker.com
RECEPTIONIST_PASSWORD=Desk@123
SEED_ON_START=true

# Demo login panel on the frontend (fetched via GET /api/auth/demo-accounts)
SHOW_DEMO_ACCOUNTS=true
SHOW_DEMO_PASSWORDS=true

# Redis (optional — falls back to in-memory cache)
REDIS_URL=
DASHBOARD_CACHE_TTL=30

# Rate limits / brute-force
RATE_LIMIT_MAX=400
AUTH_RATE_LIMIT_MAX=20
LOGIN_RATE_LIMIT_MAX=10
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MS=900000

# Email (optional — without SMTP, messages go to EmailOutbox + console)
SMTP_URL=
EMAIL_FROM=Doctor Tracker <noreply@doctortracker.local>

# Telemedicine join link base
TELE_JOIN_BASE=https://meet.example.local/session

# Clinic timezone for date-only filters (dashboard ranges, appointment days)
# Examples: UTC, Asia/Dhaka, America/New_York, Europe/London
CLINIC_TIMEZONE=UTC

# Production / Vercel
# COOKIE_SECURE=true
# CLIENT_ORIGIN=https://your-frontend.vercel.app
# SHOW_DEMO_PASSWORDS=false
