# Backend (copy values into backend/.env)
PORT=4821
APP_NAME=Doctor Tracker
PUBLIC_API_URL=http://127.0.0.1:4821

# MongoDB Atlas (recommended for real deploys) or local MongoDB.
# Leave blank to use in-memory MongoDB for demos.
# MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/doctor-tracker?retryWrites=true&w=majority
MONGODB_URI=

JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=14
COOKIE_SECURE=false
CLIENT_ORIGIN=http://127.0.0.1:4317,http://localhost:4317

ADMIN_NAME=Clinic Admin
ADMIN_EMAIL=admin@doctortracker.com
ADMIN_PASSWORD=Admin@123
RECEPTIONIST_NAME=Front Desk
RECEPTIONIST_EMAIL=front.desk@doctortracker.com
RECEPTIONIST_PASSWORD=Desk@123
SEED_ON_START=true
SHOW_DEMO_ACCOUNTS=true
SHOW_DEMO_PASSWORDS=true

REDIS_URL=
DASHBOARD_CACHE_TTL=30
SMTP_URL=
EMAIL_FROM=Doctor Tracker <noreply@doctortracker.local>

# Frontend (copy into frontend/.env.local)
NEXT_PUBLIC_API_URL=http://127.0.0.1:4821/api
NEXT_PUBLIC_APP_NAME=Doctor Tracker
# Optional local-only prefills:
# NEXT_PUBLIC_DEFAULT_LOGIN_EMAIL=
# NEXT_PUBLIC_DEFAULT_LOGIN_PASSWORD=
