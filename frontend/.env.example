# Backend API (no trailing slash issues — include /api)
NEXT_PUBLIC_API_URL=http://127.0.0.1:4821/api

# Optional brand overrides (also available from GET /auth/demo-accounts)
NEXT_PUBLIC_APP_NAME=Doctor Tracker
NEXT_PUBLIC_APP_TAGLINE=Sign in to manage doctors, patients, and clinic analytics from one calm operations desk.

# Optional: prefill login fields for local demos only (leave blank in real deployments)
# NEXT_PUBLIC_DEFAULT_LOGIN_EMAIL=
# NEXT_PUBLIC_DEFAULT_LOGIN_PASSWORD=

# Dev proxy target for /api-proxy rewrites (defaults from NEXT_PUBLIC_API_URL)
# API_PROXY_TARGET=http://127.0.0.1:4821
